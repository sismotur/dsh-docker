# Local oMLX API key (secret) — never commit
.env

# Runtime workspace bind-mount contents (kept empty via .gitkeep)
workspace/*
!workspace/.gitkeep

# node_modules from the builder-stage lockfile dirs (global-tools, pty-build).
# Only package.json + package-lock.json are committed; installs run inside the
# Docker builder, never on the host.
node_modules/

# Headless run logs (one file per job, written by run-dsh.sh).
runs/

# Generated PDF manual (run 'make pdf' to regenerate).
dsh-manual.pdf

# macOS Finder metadata
.DS_Store
