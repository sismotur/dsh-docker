# API key passed to LiteLLM / backends. TensorFold ignores it; oMLX may require
# a matching key. dsh deepseek-official adapter reads DEEPSEEK_API_KEY.
# Copy to .env and fill in (any non-empty value is fine for local TF).
DEEPSEEK_API_KEY=changeme

# Host model layout (not mounted into the container; for human/docs reference):
# TENSORFOLD_MODEL_ROOT=~/models/tensorfold
# TENSORFOLD_BASE_URL=http://127.0.0.1:8421/v1

# Git identity for commits made inside the container (the host ~/.gitconfig is
# not mounted). Set these so the agent can commit with your identity.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
GIT_COMMITTER_NAME=Your Name
GIT_COMMITTER_EMAIL=you@example.com
